# Gather — environment configuration. Copy to .env and edit.
# Every variable the stack reads is documented here; nothing else is required.

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=gather
POSTGRES_USER=gather
# REQUIRED. Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=
# Host port for Postgres (loopback only).
POSTGRES_PORT=5432

# --- Daemon ---------------------------------------------------------------
# Host port for the daemon REST API (loopback only).
GATHER_PORT=7601
# Local gRPC API (same data, proto/gather/v1/gather.proto contract).
GATHER_GRPC_ENABLED=true
# Host port for the gRPC listener (loopback only).
GATHER_GRPC_PORT=7602
# Token source: "env" (below) or "keychain" (OS-keychain get-or-create;
# the packaged desktop default — the Tauri app reads the same entry).
GATHER_AUTH_MODE=env
# Optional bearer token for /api/v1. Empty = open (loopback-only dev).
GATHER_API_TOKEN=
# Per-request upload cap in MB.
GATHER_MAX_UPLOAD_MB=256
# Global request-rate limit (requests/sec) shared across REST and gRPC. 0 disables.
GATHER_RATE_LIMIT_RPS=50
# Max Postgres connections in the shared pool (REST/gRPC handlers + workers).
GATHER_DB_MAX_CONNECTIONS=8
# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,sqlx=warn

# --- Extraction worker (PDF text, image OCR, atomic units) ----------------
# Run the background extraction worker.
GATHER_EXTRACTION_ENABLED=true
# Seconds between extraction passes.
GATHER_EXTRACTION_INTERVAL_SECS=30
# Max rows claimed per queue per pass (1-256).
GATHER_EXTRACTION_BATCH=8
# Tesseract CLI path (bundled in the Docker image; install locally for OCR).
GATHER_TESSERACT_PATH=tesseract

# --- Contradiction scanner --------------------------------------------------
# Run the background contradiction scanner.
GATHER_SCAN_ENABLED=true
# Seconds between scan passes.
GATHER_SCAN_INTERVAL_SECS=600
# Minimum score (0-1) to record a contradiction.
GATHER_SCAN_THRESHOLD=0.65
# Max unscanned units per pass / candidates per blocking strategy.
GATHER_SCAN_BATCH=32
GATHER_SCAN_MAX_CANDIDATES=25

# --- Auto-act admission (autonomous pipeline) ------------------------------
# A freshly extracted unit at/above this confidence is admitted silently; in
# the band below it (but at/above the drop floor) it is still admitted and
# parked in the review queue for optional attention. Default 0.5.
GATHER_ADMIT_HOLD_BELOW=0.5
# Confidence below which a unit is retracted on ingest. Default 0.0 = never
# drop user data (conservative); raise it only to auto-discard the weakest units.
GATHER_ADMIT_DROP_BELOW=0.0

# --- Clustering (entity auto-resolution + topic grouping) ------------------
GATHER_CLUSTER_ENABLED=true
# Seconds between clustering passes.
GATHER_CLUSTER_INTERVAL_SECS=900
# Max unclustered units claimed per topic pass.
GATHER_CLUSTER_BATCH=500
# k for the mutual-kNN graph, and the minimum edge similarity (0-1).
GATHER_CLUSTER_K=6
GATHER_CLUSTER_THRESHOLD=0.5
# Components larger than this are treated as too diffuse to auto-label.
GATHER_CLUSTER_MAX_COMPONENT=50

# --- Active learning + auto-tuning -------------------------------------------
# Let feedback move decision thresholds (bounded, audited, resettable via
# POST /api/v1/tuning/reset). The tray is re-ranked either way.
GATHER_TUNE_ENABLED=true
# Seconds between re-rank / tuning passes.
GATHER_TUNE_INTERVAL_SECS=600
# Labels needed at/above a threshold before it may move.
GATHER_TUNE_MIN_SAMPLES=20
# Precision the auto-accepted band must hold (0-1).
GATHER_TUNE_TARGET_PRECISION=0.90

# --- Photo pipeline -----------------------------------------------------------
# Perceptual-hash near-duplicate groups + EXIF time/place albums (pure Rust,
# offline). Photos are grouped, never deleted.
GATHER_PHOTO_ENABLED=true
GATHER_PHOTO_INTERVAL_SECS=600
# Photos hashed (and captioned, if enabled) per pass.
GATHER_PHOTO_BATCH=32
# Max differing hash bits (0-16) for two photos to count as near-duplicates.
GATHER_PHOTO_DUP_MAX_DISTANCE=6
# New album after this many hours without a shot, or this many km of travel.
GATHER_PHOTO_ALBUM_GAP_HOURS=3
GATHER_PHOTO_ALBUM_SPLIT_KM=10
GATHER_PHOTO_ALBUM_MIN_SIZE=2
# Caption-embedding similarity (0-1) for two photos to share a visual topic.
GATHER_PHOTO_TOPIC_THRESHOLD=0.8

# --- Optional local LLM (Ollama) — OPT-IN, loopback only -------------------
# Empty = disabled (default). Set to http://127.0.0.1:11434 to enable
# LLM-assisted extraction and embeddings. Non-loopback URLs are refused.
GATHER_OLLAMA_URL=
GATHER_OLLAMA_MODEL=llama3.2:3b
GATHER_OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional local vision model for photo captions + visual topics (e.g.
# moondream, llava). Empty = off. Requires GATHER_OLLAMA_URL.
GATHER_OLLAMA_VISION_MODEL=

# --- Observability (only with: docker compose --profile observability up) --
GRAFANA_ADMIN_PASSWORD=admin
